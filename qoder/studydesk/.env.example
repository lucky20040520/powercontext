# 研习台 StudyDesk 配置示例 —— 复制为 .env 后按需修改（勿提交真实凭据）

# ---- 知识库（seekdb 嵌入式）----
# seekdb 数据目录（相对项目根目录；可改为绝对路径如 D:/studydesk-data/kb）
STUDYDESK_DB_DIR=./data/seekdb
STUDYDESK_DB_NAME=studydesk

# ---- 向量化（本地 transformers.js，无需外部 API）----
# 模型：中文友好 bge-small-zh-v1.5（q8，512 维）
STUDYDESK_EMBED_MODEL=Xenova/bge-small-zh-v1.5
STUDYDESK_EMBED_DTYPE=q8
# 模型缓存目录（D 盘示例；默认 ./.cache）
STUDYDESK_EMBED_CACHE=./.cache
# 模型下载源（中国大陆使用 hf-mirror）
STUDYDESK_HF_ENDPOINT=https://hf-mirror.com

# ---- 长期记忆（PowerContext 服务）----
# PowerContext Server 地址（先按运行说明启动 server 再使用）
POWERCONTEXT_SERVER_URL=http://127.0.0.1:8000
# 记忆 Scope：可先用 CLI 创建（powercontext scope create --title ... --summary ...），
# 或留空由应用自动创建
POWERCONTEXT_SCOPE_ID=

# ---- 应用 ----
# Web 界面端口
STUDYDESK_WEB_PORT=8787
# 默认用户名（用于 Web 界面展示与周报抬头）
STUDYDESK_USER_NAME=同学
